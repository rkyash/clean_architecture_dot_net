{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=mosquito_main;Username=postgres;Password=XXXX;Port=5432;",
    "AuditConnection": "Host=localhost;Database=mosquito_audit;Username=postgres;Password=XXXXX;Port=5432;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Information",
      "MosquitoApi": "Debug"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Information",
        "System": "Information"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:4200",
      "http://localhost:5173"
    ]
  },
  "Scalar": {
    "Servers": [
      {
        "Url": "https://localhost:7001",
        "Description": "Development Server (HTTPS)"
      },
      {
        "Url": "http://localhost:5000",
        "Description": "Development Server (HTTP)"
      }
    ]
  },
  "RateLimiting": {
    "GlobalLimitPerMinute": 1000,
    "ApiLimitPerMinute": 500,
    "SearchLimitPerMinute": 200
  },
  "JwtSettings": {
    "SecretKey": "DevelopmentSecretKeyForJWTTokensInMosquitoAPI_DEV_2024!@#$%^&*()",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 30,
    "ClockSkewMinutes": 10
  },
  "Application": {
    "Environment": "Development",
    "DebugMode": true,
    "Password": {
      "MinimumLength": 4,
      "RequireSpecialCharacter": false
    },
    "UserAccount": {
      "MaxFailedLoginAttempts": 10,
      "LockoutDurationMinutes": 5,
      "RequireEmailVerification": false,
      "EmailVerificationTokenExpirationHours": 72,
      "PasswordResetTokenExpirationHours": 24
    }
  },
  "Email": {
    "Enabled": true,
    "SmtpHost": "localhost",
    "SmtpPort": 1025,
    "UseSsl": false,
    "FromEmail": "dev@mosquitoapi.local",
    "FromName": "Mosquito API (Dev)"
  }
