{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=mosquito_main;Username=XXX;Password=XXXXXXX;Port=5432;",
    "AuditConnection": "Host=localhost;Database=mosquito_audit;Username=XXXX;Password=XXXXXXX;Port=5432;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/mosquito-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {CorrelationId} {SourceContext}: {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "Scalar": {
    "Title": "Mosquito API Documentation",
    "Description": "A comprehensive API for managing mosquito data with Clean Architecture",
    "Version": "v1.0.0",
    "Theme": "purple",
    "ShowSidebar": true,
    "HideDownloadButton": false,
    "DarkMode": true,
    "Layout": "modern",
    "Servers": [
      {
        "Url": "https://localhost:7001",
        "Description": "Development Server"
      },
      {
        "Url": "https://staging-api.mosquito.com",
        "Description": "Staging Server"
      },
      {
        "Url": "https://api.mosquito.com",
        "Description": "Production Server"
      }
    ]
  },
  "HealthChecks": {
    "CheckIntervalSeconds": 30,
    "FailureNotificationsEnabled": true
  },
  "RateLimiting": {
    "GlobalLimitPerMinute": 100,
    "ApiLimitPerMinute": 50,
    "SearchLimitPerMinute": 20
  },
  "JwtSettings": {
    "SecretKey": "ThisIsAVerySecureSecretKeyForJWTTokensInMosquitoAPI_2024!@#$%",
    "Issuer": "MosquitoApi",
    "Audience": "MosquitoApi.Users",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7,
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateLifetime": true,
    "ValidateIssuerSigningKey": true,
    "ClockSkewMinutes": 5
  },
  "Application": {
    "Name": "Mosquito API",
    "Version": "1.0.0",
    "Environment": "Production",
    "DebugMode": false,
    "MaxPageSize": 100,
    "DefaultPageSize": 20,
    "Password": {
      "MinimumLength": 6,
      "MaximumLength": 100,
      "RequireUppercase": true,
      "RequireLowercase": true,
      "RequireDigit": true,
      "RequireSpecialCharacter": true
    },
    "UserAccount": {
      "MaxFailedLoginAttempts": 5,
      "LockoutDurationMinutes": 30,
      "RequireEmailVerification": true,
      "EmailVerificationTokenExpirationHours": 24,
      "PasswordResetTokenExpirationHours": 1
    }
  },
  "Email": {
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpUsername": "",
    "SmtpPassword": "",
    "UseSsl": true,
    "FromEmail": "noreply@mosquitoapi.com",
    "FromName": "Mosquito API",
    "Enabled": false
  },
  "FileUpload": {
    "MaxFileSizeBytes": 10485760,
    "AllowedExtensions": [".jpg", ".jpeg", ".png", ".gif", ".pdf", ".doc", ".docx"],
    "UploadPath": "uploads",
    "UseCloudStorage": false,
    "CloudStorageConnectionString": null
  },
  "Cache": {
    "Enabled": true,
    "DefaultExpirationMinutes": 60,
    "Provider": "Memory",
    "Redis": {
      "InstanceName": "MosquitoApi",
      "Database": 0,
      "ConnectTimeoutSeconds": 5
    }
  }
}